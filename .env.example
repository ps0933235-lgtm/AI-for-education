OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Local development prints one-time password reset links in the server terminal.
# Production password resets use Resend; configure both values after verifying
# your sender address/domain with Resend.
RESEND_API_KEY=
RESET_FROM_EMAIL=

# Set NODE_ENV=production only behind HTTPS with reset email configured.
NODE_ENV=development
